     "source_id": "SRC-d0185157e7ac15296c8c",
     "text": "from decimal import Decimal"
    },
    {
     "sha256": "33170cc166df18814f6749034f552591b1bb498936d834a56d3d19619942148d",
     "source_id": "SRC-235f1633291ca878fb63",
     "text": "from src.demo.billing import total"
    },
    {
     "sha256": "33170cc166df18814f6749034f552591b1bb498936d834a56d3d19619942148d",
     "source_id": "SRC-7525201a0ee817741949",
     "text": "def test_total_rounds_once_on_the_invoice_total():"
    },
    {
     "sha256": "33170cc166df18814f6749034f552591b1bb498936d834a56d3d19619942148d",
     "source_id": "SRC-e27220a44019d6df4041",
     "text": "# three lines of 0.005 must sum to 0.015 -> 0.02, not 3 * 0.01 = 0.03"
    },
    {
     "sha256": "33170cc166df18814f6749034f552591b1bb498936d834a56d3d19619942148d",
     "source_id": "SRC-200844cc4b18e9d1d7d2",
     "text": "lines = [(\"0.005\", 1), (\"0.005\", 1), (\"0.005\", 1)]"
    },
    {
     "sha256": "33170cc166df18814f6749034f552591b1bb498936d834a56d3d19619942148d",
     "source_id": "SRC-08cbf56aa106523a5327",
     "text": "assert total(lines) == Decimal(\"0.02\")"
    },
    {
     "sha256": "33170cc166df18814f6749034f552591b1bb498936d834a56d3d19619942148d",
     "source_id": "SRC-12576bc05a8e3cd50e1a",
     "text": "def test_total_keeps_exact_cents():"
    },
    {
     "sha256": "33170cc166df18814f6749034f552591b1bb498936d834a56d3d19619942148d",
     "source_id": "SRC-4085174fe63ffe5d20ec",
     "text": "assert total([(\"1.23\", 2), (\"0.02\", 1)]) == Decimal(\"2.48\")"
    }
   ]
  },
