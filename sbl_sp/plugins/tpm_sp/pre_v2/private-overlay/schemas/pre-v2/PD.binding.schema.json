{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbl:pre-v2-active:PD.binding:2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding_state": {
          "const": "UNBOUND_CANDIDATE"
        },
        "repo": {
          "type": "null"
        },
        "binding_request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "required"
          ]
        }
      },
      "required": [
        "binding_state",
        "repo",
        "binding_request"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding_state": {
          "const": "PROBE_OBSERVED"
        },
        "repo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            },
            "head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "dirty": {
              "type": "boolean"
            },
            "status_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "tracked": {
              "type": "integer",
              "minimum": 0
            },
            "untracked": {
              "type": "integer",
              "minimum": 0
            },
            "write_scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "preimages": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "const": "ABSENT"
                  }
                ]
              }
            },
            "process_writable": {
              "type": "boolean"
            }
          },
          "required": [
            "root",
            "head",
            "branch",
            "dirty",
            "status_sha256",
            "tracked",
            "untracked",
            "write_scope",
            "preimages",
            "process_writable"
          ]
        },
        "currentness_epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "string",
          "minLength": 1
        },
        "permission_basis": {
          "const": "PROCESS_ACL_ONLY_NOT_EFFECT_GRANT"
        }
      },
      "required": [
        "binding_state",
        "repo",
        "currentness_epoch",
        "observed_at",
        "permission_basis"
      ]
    }
  ]
}
