{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipd:s0:PD-PKG:1",
  "x-s0": {
    "index": "07",
    "contract": "PD-PKG",
    "materialization": "REQUIRED_NOW",
    "owner": "PIPD",
    "consumers": ["execution handoff"]
  },
  "type": "object",
  "description": "Owner: PIPD. Consumer: execution handoff.",
  "additionalProperties": false,
  "required": [
    "RepoContext",
    "currentness",
    "late_bound_construction_binding",
    "subject_id",
    "version",
    "content_hash",
    "schema_version"
  ],
  "properties": {
    "RepoContext": {},
    "currentness": {},
    "late_bound_construction_binding": {},
    "evidence_completeness": {
      "type": "object",
      "description": "What the bind-time probe actually observed. Optional (not required) so every PD written before this block existed still validates; bind_pd always writes it.",
      "additionalProperties": false,
      "required": [
        "probe_version",
        "git_root_resolved",
        "index_digest_present",
        "untracked_observed",
        "acl_state",
        "capability_keys"
      ],
      "properties": {
        "probe_version": {
          "type": "string",
          "minLength": 1
        },
        "git_root_resolved": {
          "type": "boolean"
        },
        "index_digest_present": {
          "type": "boolean"
        },
        "untracked_observed": {
          "type": "boolean"
        },
        "acl_state": {
          "type": ["string", "null"]
        },
        "capability_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subject_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
