{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipd:s0:ArtifactIdentity:1",
  "x-s0": {
    "index": "01",
    "contract": "ArtifactIdentity",
    "materialization": "REQUIRED_NOW",
    "owner": "PIPD",
    "consumers": ["all planes"]
  },
  "type": "object",
  "description": "Owner: PIPD. Consumer: all planes.",
  "additionalProperties": false,
  "required": [
    "subject_id",
    "version",
    "content_hash",
    "schema_version",
    "supersedes",
    "invalidates"
  ],
  "properties": {
    "subject_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "supersedes": {},
    "invalidates": {}
  }
}
