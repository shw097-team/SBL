{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipd:skill:pipd-route-intake:output:1",
  "title": "pipd-route-intake output",
  "description": "Owner: PIPD-EC. Consumer: pipd-pi-compile. A typed IntentCard with requirement atoms, content-addressed so the same intake lock reproduces the same id.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subject_id": {
      "type": "string",
      "pattern": "^INTENT-[0-9a-f]{16}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "schema_version": {
      "const": "IntentCard@1"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rel": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\\.\\."
            }
          }
        },
        "required": [
          "rel"
        ]
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "atoms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "req_id": {
            "enum": [
              "REQ-INTENT",
              "REQ-KNOWLEDGE",
              "REQ-VERIFY",
              "REQ-DELIVER",
              "REQ-GOVERN"
            ]
          },
          "axis": {
            "enum": [
              "intent",
              "knowledge",
              "verification",
              "release",
              "trust_boundary"
            ]
          }
        },
        "required": [
          "req_id",
          "axis"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "subject_id",
    "content_hash",
    "version",
    "schema_version",
    "goal",
    "sources",
    "constraints",
    "non_goals",
    "atoms"
  ]
}
