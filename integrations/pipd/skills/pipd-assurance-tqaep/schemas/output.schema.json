{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipd:skill:pipd-assurance-tqaep:output:1",
  "title": "pipd-assurance-tqaep output",
  "description": "Owner: PIPD/TQAEP semantics. Consumer: Independent checker/release. TQAEP with per-atom tests, oracles, fixtures, SoD acceptance and affected-only requalification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subject_id": {
      "type": "string",
      "pattern": "^TQAEP-[0-9a-f]{16}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "schema_version": {
      "const": "TQAEP@1"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "test_id": {
            "type": "string",
            "pattern": "^TEST-REQ-[A-Z]+$"
          },
          "requirement": {
            "enum": [
              "REQ-INTENT",
              "REQ-KNOWLEDGE",
              "REQ-VERIFY",
              "REQ-DELIVER",
              "REQ-GOVERN"
            ]
          },
          "oracle": {
            "type": "string",
            "minLength": 1
          },
          "positive_fixture": {
            "type": "string",
            "minLength": 1
          },
          "negative_fixture": {
            "type": "string",
            "minLength": 1
          },
          "evidence_expectation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "test_id",
          "requirement",
          "oracle",
          "positive_fixture",
          "negative_fixture",
          "evidence_expectation"
        ]
      },
      "minItems": 1
    },
    "oracles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case": {
            "const": "INDEPENDENT_CASE_PASS"
          },
          "maker_identity": {
            "type": "string",
            "minLength": 1
          },
          "checker_identity": {
            "type": "string",
            "minLength": 1
          },
          "distinct": {
            "const": true
          },
          "checker_execution_receipt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "case",
          "maker_identity",
          "checker_identity",
          "distinct",
          "checker_execution_receipt"
        ]
      },
      "minItems": 1
    },
    "requalification": {
      "const": "affected-only"
    }
  },
  "required": [
    "subject_id",
    "content_hash",
    "version",
    "schema_version",
    "tests",
    "oracles",
    "fixtures",
    "acceptance",
    "requalification"
  ]
}
