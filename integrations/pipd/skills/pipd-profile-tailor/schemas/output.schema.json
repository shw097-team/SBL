{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipd:skill:pipd-profile-tailor:output:1",
  "title": "pipd-profile-tailor output",
  "description": "Owner: PIPD. Consumer: Skills/JIT/HGK. ProfileBinding: the EFFECTIVE profile after the safety veto, which may escalate depth and never reduce it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subject_id": {
      "type": "string",
      "pattern": "^PB-[0-9a-f]{16}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "schema_version": {
      "const": "ProfileBinding@1"
    },
    "profile": {
      "enum": [
        "LITE",
        "STANDARD",
        "ASSURED"
      ]
    },
    "requested_profile": {
      "enum": [
        "LITE",
        "STANDARD",
        "ASSURED"
      ]
    },
    "escalated": {
      "type": "boolean"
    },
    "escalation_reason": {
      "enum": [
        "provider_off_parity",
        "axis_complexity",
        null
      ]
    },
    "axes": {
      "type": "array",
      "items": {
        "enum": [
          "intent",
          "knowledge",
          "verification",
          "release",
          "trust_boundary",
          "preexisting_repo",
          "profile",
          "tech_candidates",
          "host_surface"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "vetoes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_depth": {
      "enum": [
        "L1_SCHEMA_CONTRACT",
        "L3_INTEGRATION_RUNTIME",
        "L4_FAILURE_RECOVERY"
      ]
    },
    "assurance": {
      "type": "array",
      "items": {
        "enum": [
          "deterministic_validator",
          "negative_security",
          "adversarial",
          "independent_checker"
        ]
      },
      "minItems": 1
    },
    "canonical_truth": {
      "const": "single"
    }
  },
  "required": [
    "subject_id",
    "content_hash",
    "version",
    "schema_version",
    "profile",
    "requested_profile",
    "escalated",
    "escalation_reason",
    "axes",
    "vetoes",
    "artifact_depth",
    "assurance",
    "canonical_truth"
  ]
}
